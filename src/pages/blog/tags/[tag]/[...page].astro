---
import { getAllPostsWithReadingTime } from '@/modules/post/common';
import { getUniqueTags } from '@/modules/post/tag';
import List from '@/layouts/List.astro';
import Link from '@/components/Link.astro';
import PostList from '@/components/PostList.astro';
import { ROUTES } from '@/constants/routes';
import { CONFIG_CLIENT } from '@/config/client';
import { getPageMetadata } from '@/utils/metadata';
import { pickPaginationPropsFromPage } from '@/utils/pagination';
import { slugifyTag } from '@/utils/slug';

import type { Metadata } from '@/types/common';
import type { Post } from '@/types/post';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts: Post[] = await getAllPostsWithReadingTime();
  const pageSize = CONFIG_CLIENT.PAGE_SIZE_POST_CARD;

  const uniqueTags = getUniqueTags(posts);

  // no /1 alias for page one, see the note in src/pages/blog/[...page].astro
  return uniqueTags.flatMap((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags.includes(tag));
    // slug in the url, original name via props for display - reversing a slug is lossy
    const tagPagination = paginate(filteredPosts, {
      pageSize,
      params: { tag: slugifyTag(tag) },
      props: { tagName: tag },
    });
    return tagPagination;
  });
}

const { page, tagName } = Astro.props;

const title = `#${tagName}`;

// dynamic param for metadata
const defaultMetadata = getPageMetadata('lists/blog/tags/tag');

// A tag page listing a single post is strictly less useful than that post, and
// 39 of the 69 tags are in that state. Keep the page (TagList.astro links to it)
// but leave it out of the index so it stops competing with the post itself.
const metadata: Metadata = { ...defaultMetadata, title, noindex: page.total < 2 };

const paginationProps = pickPaginationPropsFromPage(page);
const layoutProps = { metadata, paginationProps };
---

<List {...layoutProps}>
  <Fragment slot="heading">
    <div class="flex justify-between">
      <h1 class="b-h1">{title}</h1>
      <Link href={ROUTES.EXPLORE} class="mt-2 md:mt-4">all tags</Link>
    </div>
  </Fragment>
  <PostList posts={page.data} />
</List>
