---
import '@fontsource-variable/inter/index.css';
import '@/styles/main.css';

import { ClientRouter } from 'astro:transitions';

import JsonLd from '@/components/JsonLd.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import {
  DEFAULT_METADATA,
  OG_IMAGE_SIZE,
  OG_LOCALE,
  THEME_COLOR_LIGHT,
} from '@/constants/metadata';
import { ROUTES } from '@/constants/routes';
import { CONFIG_CLIENT } from '@/config/client';
import { handleTitle } from '@/utils/metadata';
import { filterUndefined } from '@/utils/objects';

import type { Metadata, ResolvedMetadata } from '@/types/common';

const { AUTHOR_NAME, AUTHOR_TWITTER, SITE_TITLE, PLAUSIBLE_SCRIPT_URL, PLAUSIBLE_DOMAIN } =
  CONFIG_CLIENT;

// AUTHOR_TWITTER is a profile url, but twitter:site wants the @handle form.
// Derived rather than written out again so the two cannot drift apart.
const twitterHandle = `@${AUTHOR_TWITTER.replace(/\/+$/, '').split('/').pop()}`;

export interface BaseHeadProps {
  metadata: Metadata;
}

// set default metadata in this component
const { metadata } = Astro.props as BaseHeadProps;

// site: SITE_URL var + '/'
// url: full page url, canonical url, per page
const { url } = Astro; // objects
const { host } = url; // host - marcandreuf.com

const handledMetadata = handleTitle(metadata);

const filteredMetadata = filterUndefined(handledMetadata);
const mergedMetadata: ResolvedMetadata = { ...DEFAULT_METADATA, ...filteredMetadata };

const { title, description, image, noindex, ogType, article } = mergedMetadata;

const ogImageUrl = new URL(image, url);

// handleTitle() appends " - Marc Andreu" for the <title> and the social cards.
// schema.org headline wants the article's own headline, so the JSON-LD uses the
// title as it was passed in, falling back to the handled one for pages that set
// no title of their own.
const jsonLdTitle = metadata.title ?? title;
---

<head>
  {/* Global Metadata */}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  {/* ThemeScript.astro overwrites this with the live body background about a
      second after load, and its updateMetaTag() bails if the tag is absent, so
      the tag has to stay and has to carry a usable value until then. */}
  <meta name="theme-color" content={THEME_COLOR_LIGHT} />

  {/* 'follow' so link equity still flows to the canonical tag/category pages */}
  {noindex && <meta name="robots" content="noindex, follow" />}

  {/* Links */}
  {/* Root-Relative URL (Starts with /): */}
  <link rel="canonical" href={url} />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href={`${ROUTES.STATIC.FAVICONS}apple-touch-icon.png`}
  />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href={`${ROUTES.STATIC.FAVICONS}favicon-32x32.png`}
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href={`${ROUTES.STATIC.FAVICONS}favicon-16x16.png`}
  />
  <link rel="manifest" href="/manifest.json" />

  {/* Primary Meta Tags */}
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content={AUTHOR_NAME} />

  {/* Feeds */}
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`RSS feed for ${host}`}
    href={`${ROUTES.API.FEED_RSS}`}
  />
  <link
    rel="alternate"
    type="application/json"
    title={`JSON feed for ${host}`}
    href={`${ROUTES.API.FEED_JSON}`}
  />
  <link rel="sitemap" type="application/xml" title="Sitemap" href={`${ROUTES.STATIC.SITEMAP}`} />

  {/* Open Graph / Facebook */}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:locale" content={OG_LOCALE} />
  <meta property="og:image" content={ogImageUrl} />
  {/* Declared so a platform can reserve the space before it has fetched the
      image. Shared with the generator, see OG_IMAGE_SIZE. */}
  <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
  <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
  {/* The card renders this title as its own headline, so the title is an
      accurate description of the picture rather than a restatement of it. */}
  <meta property="og:image:alt" content={title} />

  {/* Twitter - the spec uses name=, not property=, for these */}
  {/* the open-graph images are 1200x630, which is the large-card size */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={twitterHandle} />
  <meta name="twitter:url" content={url} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={title} />

  {/* Structured data */}
  <JsonLd
    metadata={{ title: jsonLdTitle, description, ogType, article }}
    canonicalUrl={url.href}
    imageUrl={ogImageUrl.href}
  />

  {/* Analytics */}
  {
    PLAUSIBLE_SCRIPT_URL && (
      <>
        <link rel="preconnect" href={PLAUSIBLE_SCRIPT_URL} />
        {/* PLAUSIBLE_DOMAIN must be the same for all mirrors */}
        <script
          defer
          type="text/partytown"
          src={PLAUSIBLE_SCRIPT_URL}
          data-domain={PLAUSIBLE_DOMAIN}
        />
      </>
    )
  }

  {/* Theme */}
  {/* MUST be inside <head /> to avoid white flash, IMPORTANT */}
  <ThemeScript />

  <ClientRouter fallback="none" />

  <!-- 
    <style>
      @view-transition {
        navigation: auto; /* enabled! */
      }
    </style> 
  -->
</head>
